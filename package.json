{
  "name": "orchestrion-codex-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Open source macOS desktop client for local Codex sessions and governed work.",
  "engines": {
    "node": "22.x"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/require-node-22.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/require-node-22.mjs && electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:dir": "node scripts/require-node-22.mjs && electron-vite build && electron-builder --mac --arm64 --dir --publish never",
    "dist:signed:check": "node scripts/build-signed-mac.mjs --check",
    "dist:signed": "node scripts/build-signed-mac.mjs",
    "verify:dist": "node scripts/require-node-22.mjs && node scripts/verify-packaged-app.mjs",
    "smoke:dist:launch": "node scripts/require-node-22.mjs && node scripts/packaged-launch-smoke.mjs",
    "rebuild:native": "node scripts/require-node-22.mjs && electron-rebuild -f -w node-pty -v 38.8.6",
    "smoke:terminal-native": "node scripts/require-node-22.mjs && node scripts/run-electron.mjs scripts/native-terminal-smoke.mjs",
    "smoke:terminal-lifecycle-native": "node scripts/require-node-22.mjs && node scripts/run-native-workspace-lifecycle-smoke.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:signing": "node --test scripts/build-signed-mac.test.mjs scripts/build-local-keychain.test.mjs",
    "dist:local-keychain:check": "node scripts/build-local-keychain.mjs --check",
    "dist:local-keychain": "node scripts/build-local-keychain.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.544.0",
    "node-pty": "1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "3.2.7",
    "electron": "38.8.6",
    "electron-builder": "26.16.1",
    "electron-vite": "^4.0.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  },
  "build": {
    "appId": "com.orchestrion.desktop",
    "productName": "Orchestrion",
    "publish": {
      "provider": "github",
      "owner": "Robin2292",
      "repo": "Orchestrion"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "asarUnpack": [
      "out/main/native/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    }
  }
}
